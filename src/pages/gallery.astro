---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Button from '../components/ui/Button.astro';
import GalleryImage from '../components/gallery/GalleryImage.astro';
import { business } from '../data/business.ts';

// Featured
import partitionScreens from '../assets/interior/partition-screens.webp';

// Curated editorial grid (breadth: bridal, a nail highlight, the space, one fresh interior angle)
import bridal from '../assets/bridal/bridal-cropped.png';
import nailsProcess from '../assets/nails/nails-process.webp';
import mainStations from '../assets/interior/main-stations.webp';
import washArea3 from '../assets/interior/wash-area-3.webp';

// Space / interior moment
import loreaWall from '../assets/interior/loreal-wall.webp';
import kerastaseWall from '../assets/interior/kerastase-wall.webp';
import washArea from '../assets/interior/wash-area.webp';
import exterior from '../assets/interior/exterior-cropped.webp';

// Hair
import hair01 from '../assets/hair/hair-01.webp';
import hair02 from '../assets/hair/hair-02.webp';
import hair03 from '../assets/hair/hair-03.webp';

// Nail
import nails01 from '../assets/nails/nails-01.webp';
import nails02 from '../assets/nails/nails-02.webp';
import nails03 from '../assets/nails/nails-03.png';

// Final / contact moment
import secondaryStation from '../assets/interior/secondary-station.webp';

const description =
	"A closer look at Monsoon Salon's work and space in Kokapet, Hyderabad — hair, nails, and the salon itself.";
---

<BaseLayout title="Gallery" description={description}>
	<!-- Intro -->
	<section class="pt-14 pb-4 sm:pt-20">
		<Container size="narrow" class="text-center" data-reveal>
			<p class="font-body text-xs tracking-[0.2em] text-iron/50 uppercase">Our work</p>
			<h1 class="mt-3 font-display text-3xl sm:text-4xl">Gallery</h1>
			<p class="mx-auto mt-4 max-w-md font-body text-base text-iron/70">
				A closer look at the work coming out of {business.name} — hair, nails, and the space
				itself, in {business.location}.
			</p>
		</Container>
	</section>

	<!-- Featured image -->
	<section class="py-10 sm:py-14" data-reveal>
		<Container size="narrow">
			<GalleryImage
				image={partitionScreens}
				alt="The black iron partition screens and styling area at Monsoon Salon"
				class="aspect-4/5 w-full md:aspect-3/4"
			/>
		</Container>
	</section>

	<!-- Curated editorial grid -->
	<section class="py-10 sm:py-14">
		<Container data-reveal>
			<h2 class="font-body text-xs tracking-[0.2em] text-iron/50 uppercase">Highlights</h2>
			<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
				<GalleryImage
					image={bridal}
					alt="Bridal styling work at Monsoon Salon"
					class="col-span-2 row-span-2 aspect-square sm:aspect-auto"
				/>
				<GalleryImage
					image={nailsProcess}
					alt="A nail service being performed at Monsoon Salon"
					class="col-span-1 aspect-4/5 sm:col-span-2"
				/>
				<GalleryImage
					image={mainStations}
					alt="The main styling stations at Monsoon Salon"
					class="col-span-1 aspect-4/5 sm:col-span-2"
				/>
				<GalleryImage
					image={washArea3}
					alt="The pedicure seating area at Monsoon Salon"
					class="col-span-2 aspect-square sm:col-span-1"
				/>
			</div>
		</Container>
	</section>

	<!-- Space / interior moment -->
	<section class="py-10 sm:py-14">
		<Container data-reveal>
			<h2 class="font-body text-xs tracking-[0.2em] text-iron/50 uppercase">The space</h2>
			<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
				<GalleryImage
					image={loreaWall}
					alt="The L'Oréal Professionnel colour bar at Monsoon Salon"
					class="col-span-2 aspect-4/5 sm:col-span-2"
				/>
				<GalleryImage
					image={exterior}
					alt="The Monsoon Salon storefront in Kokapet"
					class="col-span-2 aspect-4/5 sm:col-span-2"
				/>
				<GalleryImage
					image={kerastaseWall}
					alt="The Kérastase treatment wall at Monsoon Salon"
					class="col-span-1 aspect-square sm:col-span-1"
				/>
				<GalleryImage
					image={washArea}
					alt="The wash area at Monsoon Salon"
					class="col-span-1 aspect-square sm:col-span-1 sm:col-start-4"
				/>
			</div>
		</Container>
	</section>

	<!-- Hair -->
	<section class="py-10 sm:py-14">
		<Container data-reveal>
			<h2 class="font-body text-xs tracking-[0.2em] text-iron/50 uppercase">Hair</h2>
			<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-5 sm:gap-4">
				<GalleryImage
					image={hair02}
					alt="Styled hair colour work at Monsoon Salon"
					class="col-span-2 aspect-4/5 sm:col-span-3 sm:aspect-3/4"
				/>
				<div class="col-span-2 grid grid-cols-2 gap-3 sm:col-span-2 sm:grid-cols-1 sm:gap-4">
					<GalleryImage image={hair01} alt="Styled hair at Monsoon Salon" class="aspect-square" />
					<GalleryImage image={hair03} alt="Styled hair at Monsoon Salon" class="aspect-square" />
				</div>
			</div>
		</Container>
	</section>

	<!-- Nail -->
	<section class="py-10 sm:py-14">
		<Container data-reveal>
			<h2 class="font-body text-xs tracking-[0.2em] text-iron/50 uppercase">Nail</h2>
			<div class="mt-6 grid grid-cols-3 gap-3 sm:gap-4">
				<GalleryImage image={nails01} alt="Nail art detail at Monsoon Salon" class="aspect-square" />
				<GalleryImage image={nails02} alt="Nail art detail at Monsoon Salon" class="aspect-square" />
				<GalleryImage image={nails03} alt="Nail art detail at Monsoon Salon" class="aspect-square" />
			</div>
		</Container>
	</section>

	<!-- Final image / contact moment -->
	<section class="pt-10 pb-14 sm:pt-14 sm:pb-20">
		<Container size="narrow" class="flex flex-col items-center gap-6 text-center">
			<div data-reveal class="w-full max-w-sm">
				<GalleryImage
					image={secondaryStation}
					alt="The secondary styling station at Monsoon Salon"
					class="aspect-4/5 w-full"
				/>
			</div>
			<div data-reveal class="flex flex-col items-center gap-5">
				<p class="font-display text-xl sm:text-2xl">Like what you see?</p>
				<div class="flex flex-col gap-3 sm:flex-row">
					<Button variant="primary" href={business.phone ? `tel:${business.phone}` : null}>Call</Button>
					<Button
						variant="primary"
						class="bg-iron hover:bg-iron/90"
						href={business.whatsapp ? `https://wa.me/${business.whatsapp}` : null}
						external
					>
						WhatsApp
					</Button>
				</div>
				<Button variant="text" href="/contact">Or see full contact details →</Button>
			</div>
		</Container>
	</section>
</BaseLayout>

<!-- Lightbox overlay (shared by every GalleryImage trigger on this page) -->
<div
	data-lightbox
	data-open="false"
	hidden
	role="dialog"
	aria-modal="true"
	aria-label="Image preview"
	class="fixed inset-0 z-100 flex items-center justify-center bg-iron/90 p-6"
>
	<button
		type="button"
		data-lightbox-close
		aria-label="Close image preview"
		class="absolute top-6 right-6 flex h-10 w-10 items-center justify-center text-cream"
	>
		<svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
			<path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.5" />
		</svg>
	</button>
	<figure class="flex max-h-full max-w-4xl flex-col items-center gap-3">
		<img data-lightbox-image src="" alt="" class="max-h-[80vh] max-w-full object-contain" />
		<figcaption data-lightbox-caption class="font-body text-xs text-cream/70"></figcaption>
	</figure>
</div>

<script src="../scripts/lightbox.js"></script>
