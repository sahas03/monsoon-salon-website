---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Monsoon Salon" transparentHeader={false}>
	<section class="flex min-h-[70vh] items-center justify-center px-6 text-center">
		<div>
			<p class="font-body text-xs tracking-[0.2em] text-iron/50 uppercase">Stage 2 — foundation build</p>
			<h1 class="mt-4 font-display text-3xl text-iron">Homepage sections are built in Stage 3</h1>
			<p class="mx-auto mt-4 max-w-md font-body text-sm text-iron/70">
				This route currently exists only to verify the global design system renders correctly.
				See <a href="/style-guide" class="underline">/style-guide</a> for a token/component preview.
			</p>
		</div>
	</section>
</BaseLayout>
