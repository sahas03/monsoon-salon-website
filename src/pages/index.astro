---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import Space from '../components/sections/Space.astro';
import GalleryPreview from '../components/sections/GalleryPreview.astro';
import Trust from '../components/sections/Trust.astro';
import BrandStatement from '../components/sections/BrandStatement.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';

const description =
	"Monsoon Salon in Kokapet, Hyderabad — hair, skin, makeup, and nail services in a considered, design-led space.";
---

<BaseLayout title="Monsoon Salon" description={description} transparentHeader={true}>
	<Hero />
	<Services />
	<Space />
	<GalleryPreview />
	<Trust />
	<BrandStatement />
	<FinalCTA />
</BaseLayout>
