---
/**
 * Button primitive.
 *
 * Two variants only, matching the locked design system:
 * - "primary": solid fill, used sparingly at genuine conversion moments
 *   (hero CTA, final contact CTA). Never more than one or two per section.
 * - "text": quiet underline/arrow link, used for lower-commitment actions
 *   (per-category "Enquire about Hair →", "View Full Gallery →").
 *
 * Renders as <a> when `href` is provided, otherwise a <button>.
 * Handles a `disabled`-like "pending" state for CTAs whose destination
 * depends on unconfirmed business data (e.g. phone/WhatsApp not yet
 * confirmed) — see business.ts. This must never silently link to a
 * fabricated number; it renders as visibly inactive instead.
 */
interface Props {
	variant?: 'primary' | 'text';
	href?: string | null;
	class?: string;
	external?: boolean;
	ariaLabel?: string;
}

const {
	variant = 'primary',
	href = null,
	class: className = '',
	external = false,
	ariaLabel,
} = Astro.props;

const isPending = href === null;

const base =
	'inline-flex items-center gap-2 font-body transition-colors duration-200 focus-visible:outline-2';

const variants = {
	primary:
		'rounded-sm bg-green-primary px-6 py-3 text-cream text-sm tracking-wide hover:bg-green-deep',
	text: 'text-iron text-sm border-b border-transparent hover:border-iron pb-0.5',
};

/**
 * Pending state: a CTA whose destination depends on business data that
 * isn't confirmed yet (business.ts field is null). This must read as
 * "intentionally awaiting confirmation," not as a broken/disabled button —
 * so it gets its own distinct outline treatment rather than a washed-out
 * version of the working button, and keeps normal cursor/hover affordance
 * (no pointer-events-none, which would also silently suppress the native
 * title-attribute tooltip on hover).
 */
/*
 * Note the `!` (important) modifiers on background/text/border here:
 * callers sometimes pass a color override via `class` (e.g. Hero/FinalCTA
 * styling the WhatsApp button with `bg-iron` to distinguish it from Call).
 * That override must only apply once a real destination exists — when
 * pending, this variant needs to win regardless of Tailwind's internal
 * class-generation order, which isn't something to rely on for a visual
 * guarantee like "pending never renders as a solid-colored button."
 */
const pendingVariants = {
	primary:
		'rounded-sm border border-iron/25 !bg-transparent px-6 py-3 !text-iron/60 text-sm tracking-wide',
	text: '!text-iron/45 text-sm border-b border-transparent',
};

const classes = [
	base,
	isPending ? pendingVariants[variant] : variants[variant],
	isPending ? 'cursor-default' : '',
	className,
]
	.filter(Boolean)
	.join(' ');
---

{
	isPending ? (
		<span class={classes} aria-disabled="true" title="Contact details pending confirmation from the salon">
			<slot />
			{variant === 'primary' && (
				<span class="text-[10px] font-normal tracking-normal normal-case opacity-70">(pending)</span>
			)}
		</span>
	) : (
		<a
			href={href}
			class={classes}
			aria-label={ariaLabel}
			target={external ? '_blank' : undefined}
			rel={external ? 'noopener noreferrer' : undefined}
		>
			<slot />
		</a>
	)
}
