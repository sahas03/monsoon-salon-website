---
import { Image } from 'astro:assets';
import exteriorImage from '../../assets/interior/exterior-cropped.webp';
import Button from '../ui/Button.astro';
import Container from '../layout/Container.astro';
import { business } from '../../data/business.ts';

/**
 * Final Contact CTA — the page's conversion close.
 *
 * Call/WhatsApp render via Button's built-in pending-state handling.
 * Address / hours / email are plain text, not components with a pending
 * state of their own — so each is only rendered when actually confirmed
 * (business.<field> is non-null); nothing renders a visible "TBD" label
 * to a site visitor, and nothing is ever filled with a plausible guess.
 */
---

<section class="bg-cream py-20 sm:py-28">
	<Container>
		<div class="grid gap-10 md:grid-cols-2 md:gap-16" data-reveal>
			<div class="aspect-4/3 w-full overflow-hidden md:aspect-auto">
				<Image
					src={exteriorImage}
					alt={`${business.name} storefront in ${business.location}`}
					width={1280}
					height={655}
					class="h-full w-full object-cover"
				/>
			</div>

			<div class="flex flex-col justify-center">
				<p class="font-body text-xs tracking-[0.2em] text-iron/50 uppercase">Get in touch</p>
				<h2 class="mt-3 font-display text-3xl sm:text-4xl">Visit or reach out</h2>

				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<Button
						variant="primary"
						href={business.phone ? `tel:${business.phone}` : null}
						class="justify-center sm:flex-1"
					>
						Call
					</Button>
					<Button
						variant="primary"
						class="justify-center bg-iron hover:bg-iron/90 sm:flex-1"
						href={business.whatsapp ? `https://wa.me/${business.whatsapp}` : null}
						external
					>
						WhatsApp
					</Button>
				</div>

				<dl class="mt-10 flex flex-col gap-4 font-body text-sm text-iron/80">
					{
						business.address && (
							<div>
								<dt class="text-xs tracking-[0.15em] text-iron/50 uppercase">Address</dt>
								<dd class="mt-1">{business.address}</dd>
							</div>
						)
					}
					{
						business.hours && (
							<div>
								<dt class="text-xs tracking-[0.15em] text-iron/50 uppercase">Hours</dt>
								<dd class="mt-1">{business.hours}</dd>
							</div>
						)
					}
					{
						business.email && (
							<div>
								<dt class="text-xs tracking-[0.15em] text-iron/50 uppercase">Email</dt>
								<dd class="mt-1">{business.email}</dd>
							</div>
						)
					}
				</dl>
			</div>
		</div>
	</Container>
</section>
