---
import { Image, getImage } from 'astro:assets';
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';

import hair01 from '../../assets/hair/hair-01.webp';
import hair03 from '../../assets/hair/hair-03.webp';
import nails01 from '../../assets/nails/nails-01.webp';
import nails02 from '../../assets/nails/nails-02.webp';
import nails03 from '../../assets/nails/nails-03.png';
import washArea from '../../assets/interior/wash-area.webp';
import secondaryStation from '../../assets/interior/secondary-station.webp';

/**
 * Gallery preview — curated asymmetric grid, not an Instagram-style
 * uniform feed. One large anchor, medium and small supporting tiles.
 *
 * Correction pass note: this list deliberately avoids reusing any image
 * already shown in the Services section (nails-process, hair-02, and
 * bridal-cropped all live there) — the original version repeated all
 * three on the same page, which read as unintentional rather than
 * curated. hair-01 now anchors the grid instead, and nails-03 /
 * secondary-station (previously imported but unused) fill out the
 * variety in their place.
 */

const items = [
	{ image: hair01, alt: 'Styled hair at Monsoon Salon', size: 'large' },
	{ image: nails03, alt: 'Nail art detail at Monsoon Salon', size: 'medium' },
	{ image: secondaryStation, alt: 'The secondary styling station at Monsoon Salon', size: 'medium' },
	{ image: nails01, alt: 'Nail art detail at Monsoon Salon', size: 'small' },
	{ image: hair03, alt: 'Styled hair at Monsoon Salon', size: 'small' },
	{ image: washArea, alt: 'The wash area at Monsoon Salon', size: 'medium' },
	{ image: nails02, alt: 'Nail art detail at Monsoon Salon', size: 'small' },
];

const sizeClasses = {
	large: 'sm:col-span-3 sm:row-span-2 aspect-square sm:aspect-auto',
	medium: 'sm:col-span-2 sm:row-span-1 aspect-4/5',
	small: 'sm:col-span-1 sm:row-span-1 aspect-square',
};

// Precompute a reasonably sized "full view" source for the lightbox —
// capped at each image's native width so nothing is upscaled.
const fullImages = await Promise.all(
	items.map((item) => getImage({ src: item.image, width: item.image.width }))
);
---

<section class="bg-cream pt-14 pb-16 sm:pt-20 sm:pb-24">
	<Container class="flex flex-col gap-10">
		<header data-reveal class="flex flex-wrap items-end justify-between gap-4">
			<div>
				<p class="font-body text-xs tracking-[0.2em] text-iron/50 uppercase">Our work</p>
				<h2 class="mt-3 font-display text-3xl sm:text-4xl">A closer look</h2>
			</div>
			<Button variant="text" href="/gallery" class="hidden sm:inline-flex">View Full Gallery →</Button>
		</header>

		<div data-reveal class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
			{
				items.map((item, i) => (
					<button
						type="button"
						data-lightbox-trigger
						data-full-src={fullImages[i].src}
						data-full-alt={item.alt}
						class={`group relative overflow-hidden ${sizeClasses[item.size]}`}
						aria-label={`View larger image: ${item.alt}`}
					>
						<Image
							src={item.image}
							alt={item.alt}
							width={item.image.width}
							height={item.image.height}
							class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
						/>
					</button>
				))
			}

			<a
				href="/gallery"
				class="col-span-2 flex aspect-square items-center justify-center bg-cream-deep font-body text-sm text-iron transition-colors hover:bg-iron hover:text-cream sm:col-span-1 sm:aspect-square"
			>
				View Full Gallery →
			</a>
		</div>
	</Container>
</section>

<!-- Lightbox overlay -->
<div
	data-lightbox
	data-open="false"
	hidden
	role="dialog"
	aria-modal="true"
	aria-label="Image preview"
	class="fixed inset-0 z-100 flex items-center justify-center bg-iron/90 p-6"
>
	<button
		type="button"
		data-lightbox-close
		aria-label="Close image preview"
		class="absolute top-6 right-6 flex h-10 w-10 items-center justify-center text-cream"
	>
		<svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
			<path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.5" />
		</svg>
	</button>
	<figure class="flex max-h-full max-w-4xl flex-col items-center gap-3">
		<img data-lightbox-image src="" alt="" class="max-h-[80vh] max-w-full object-contain" />
		<figcaption data-lightbox-caption class="font-body text-xs text-cream/70"></figcaption>
	</figure>
</div>

<script src="../../scripts/lightbox.js"></script>
