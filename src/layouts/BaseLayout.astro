---
import '../styles/global.css';
import { business } from '../data/business.ts';
import Header from '../components/layout/Header.astro';

/**
 * Base page shell. Every page renders through this layout.
 *
 * Font loading: Fraunces (display) + Inter (body — standing in for the
 * still-provisional "General Sans" candidate; see src/styles/global.css
 * for the swap point). Loaded via Google Fonts for now since both this
 * combination and the eventual real pairing are unconfirmed — swapping
 * either typeface later means changing this one <link> plus the
 * --font-display / --font-body values in global.css, nothing else.
 */
interface Props {
	title: string;
	description?: string;
	/** Pass true only for the homepage, which has a full-bleed hero. */
	transparentHeader?: boolean;
}

const { title, description, transparentHeader = false } = Astro.props;

const pageTitle = title === business.name ? title : `${title} · ${business.name}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}

		<!-- Provisional font pairing — see note above. -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-cream font-body text-iron antialiased">
		<Header transparent={transparentHeader} />
		<main class={`pb-16 md:pb-0 ${transparentHeader ? '' : 'pt-20'}`}>
			<slot />
		</main>
		<!-- Footer intentionally not built in this stage — see project notes. -->

		<script src="../scripts/reveal.js"></script>
	</body>
</html>
